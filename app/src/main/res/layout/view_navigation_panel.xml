<?xml version="1.0" encoding="utf-8"?>
<!-- Navigation overlay shared by the real and Robolectric map layouts; parent is the map ConstraintLayout. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="androidx.constraintlayout.widget.ConstraintLayout">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/navigationManeuverCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/nav_card"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:strokeWidth="0dp"
        app:layout_constraintEnd_toStartOf="@id/mainMenuButton"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_default="wrap"
        app:layout_constraintWidth_max="280dp"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                android:id="@+id/navigationManeuverIcon"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:importantForAccessibility="no"
                app:tint="@color/nav_accent"
                tools:src="@drawable/ic_maneuver_left" />

            <LinearLayout
                android:id="@+id/navigationManeuverTextBlock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/navigationManeuverDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textColor="@color/nav_text"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    tools:text="350 m" />

                <TextView
                    android:id="@+id/navigationManeuver"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/nav_text"
                    android:textSize="17sp"
                    tools:text="Turn right" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/navigationSpeedLimit"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_speed_limit"
        android:elevation="4dp"
        android:gravity="center"
        android:maxLines="1"
        android:padding="8dp"
        android:textColor="#000000"
        android:textStyle="bold"
        android:visibility="gone"
        app:autoSizeMaxTextSize="24sp"
        app:autoSizeMinTextSize="12sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/navigationManeuverCard"
        app:layout_goneMarginTop="12dp"
        tools:text="60"
        tools:visibility="visible" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/navigationPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/nav_card"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="4dp"
                android:paddingBottom="8dp">

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/navigationSummary"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:gravity="center_vertical"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textColor="@color/nav_text"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        app:autoSizeMaxTextSize="20sp"
                        app:autoSizeMinTextSize="14sp"
                        app:autoSizeTextType="uniform"
                        tools:text="12 min · 8.4 km" />

                    <TextView
                        android:id="@+id/navigationStatus"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:gravity="center_vertical"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textColor="@color/nav_text_secondary"
                        android:textSize="16sp"
                        android:visibility="gone"
                        app:autoSizeMaxTextSize="16sp"
                        app:autoSizeMinTextSize="12sp"
                        app:autoSizeTextType="uniform" />
                </FrameLayout>

                <ImageButton
                    android:id="@+id/navigationStop"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/navigation_stop"
                    android:src="@drawable/ic_close"
                    app:tint="@color/nav_text" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navigationOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/navigationActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp">

                <Button
                    android:id="@+id/navigationRetry"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/navigation_retry" />

                <Button
                    android:id="@+id/navigationSetup"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/navigation_road_data" />

                <Button
                    android:id="@+id/navigationGo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:backgroundTint="@color/nav_accent"
                    android:text="@string/navigation_go"
                    android:textSize="18sp" />
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/navigationProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="1000"
                app:indicatorColor="@color/nav_accent"
                app:trackColor="@color/nav_track"
                app:trackThickness="4dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</merge>
