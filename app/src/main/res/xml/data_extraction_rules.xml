<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="auth_prefs.xml" />
        <exclude domain="sharedpref" path="LocationServicePrefs.xml" />
        <exclude domain="file" path="gpx/" />
        <exclude domain="file" path="maps/" />
        <exclude domain="file" path="placemarks.json" />
        <exclude domain="file" path="gas_stations.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="auth_prefs.xml" />
        <exclude domain="sharedpref" path="LocationServicePrefs.xml" />
        <exclude domain="file" path="gpx/" />
        <exclude domain="file" path="maps/" />
        <exclude domain="file" path="placemarks.json" />
        <exclude domain="file" path="gas_stations.json" />
    </device-transfer>
</data-extraction-rules>
