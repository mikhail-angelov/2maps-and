<full-backup-content>
    <exclude domain="sharedpref" path="auth_prefs.xml" />
    <exclude domain="sharedpref" path="LocationServicePrefs.xml" />
    <exclude domain="sharedpref" path="home_prefs.xml" />
    <exclude domain="file" path="gpx/" />
    <exclude domain="file" path="maps/" />
        <exclude domain="file" path="routing/" />
    <exclude domain="file" path="placemarks.json" />
    <exclude domain="file" path="gas_stations.json" />
    <exclude domain="file" path="trips.json" />
</full-backup-content>
